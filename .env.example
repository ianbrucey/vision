# ============================================================================
# Vision — Environment Variables
# ============================================================================
# Copy to .env and fill in your values:
#   cp .env.example .env
#
# Never commit .env to version control. It is in .gitignore by convention.

# ---------------------------------------------------------------------------
# Database (PostgreSQL 15 + pgvector)
# ---------------------------------------------------------------------------
# These match the docker-compose.yml defaults. Change if you're connecting
# to a different Postgres instance.
VISION_DB_HOST=127.0.0.1
VISION_DB_PORT=5433
VISION_DB_DATABASE=vision
VISION_DB_USERNAME=vision
VISION_DB_PASSWORD=vision_dev

# ---------------------------------------------------------------------------
# DataLab — PDF OCR (structured JSON output)
# ---------------------------------------------------------------------------
# Get your API key from: https://datalab.com (or your DataLab provider)
# Also reads the legacy DATALABS_API_KEY env var as fallback.
DATALAB_API_KEY=your_datalab_api_key_here

# ---------------------------------------------------------------------------
# Mistral AI — LLM calls + embeddings
# ---------------------------------------------------------------------------
# Get your API key at: https://console.mistral.ai/api-keys/
# Used for: Stage 0 intake extraction, section embeddings (1024-dim)
MISTRAL_API_KEY=your_mistral_api_key_here

# ---------------------------------------------------------------------------
# Anthropic API — Reasoning + agent dispatch
# ---------------------------------------------------------------------------
# The Agent SDK uses this to connect to your LLM provider.
# We use DeepSeek via their Anthropic-compatible endpoint.
# Set ANTHROPIC_BASE_URL to your provider's endpoint.
# Get your API key at: https://platform.deepseek.com/api_keys
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
ANTHROPIC_API_KEY=your_api_key_here
ANTHROPIC_MODEL=deepseek-v4-pro

# ---------------------------------------------------------------------------
# MinIO — S3-compatible object storage (document uploads)
# ---------------------------------------------------------------------------
# If you're running the docker-compose MinIO service, the defaults below
# will work out of the box (127.0.0.1:9002, minioadmin/minioadmin).
#
# If you have a brew-installed MinIO on port 9000, change the endpoint:
#   MINIO_ENDPOINT=127.0.0.1:9000
#   MINIO_ACCESS_KEY=herd
#   MINIO_SECRET_KEY=secretkey
MINIO_ENDPOINT=127.0.0.1:9002
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=vision-uploads
MINIO_SECURE=false

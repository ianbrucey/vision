# Vision — Environment Configuration
# Copy this file to .env and fill in your values.
#   cp .env.example .env

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# For DBngin (macOS GUI):
#   VISION_DB_HOST=127.0.0.1
#   VISION_DB_PORT=5432
#   VISION_DB_USERNAME=<your system username>
#   VISION_DB_PASSWORD=
#
# For Docker (docker-compose.yml):
#   VISION_DB_HOST=127.0.0.1
#   VISION_DB_PORT=5433
#   VISION_DB_USERNAME=vision
#   VISION_DB_PASSWORD=vision_dev
# ---------------------------------------------------------------------------
VISION_DB_HOST=127.0.0.1
VISION_DB_PORT=5432
VISION_DB_DATABASE=vision
VISION_DB_USERNAME=ianbruce
VISION_DB_PASSWORD=

# ---------------------------------------------------------------------------
# LLM / AI
# ---------------------------------------------------------------------------
# DeepSeek (Anthropic-compatible API)
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_MODEL=deepseek-v4-pro[1m]
ANTHROPIC_DEFAULT_OPUS_MODEL=deepseek-v4-pro[1m]
ANTHROPIC_DEFAULT_SONNET_MODEL=deepseek-v4-pro[1m]
ANTHROPIC_DEFAULT_HAIKU_MODEL=deepseek-v4-flash[1m]

# DataLab API (PDF OCR/parsing — optional)
DATALAB_API_KEY=
DATALAB_API_URL=https://api.datalab.to

# ---------------------------------------------------------------------------
# Storage (MinIO — S3-compatible)
# ---------------------------------------------------------------------------
# For DBngin: 127.0.0.1:9000
# For Docker: 127.0.0.1:9002
# ---------------------------------------------------------------------------
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=vision-uploads
MINIO_SECURE=false

# ---------------------------------------------------------------------------
# JWT
# ---------------------------------------------------------------------------
VISION_JWT_SECRET=vision-dev-secret-change-in-production

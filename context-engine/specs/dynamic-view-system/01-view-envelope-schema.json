{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vision.local/schemas/view-envelope-v1.json",
  "title": "Vision Dynamic View Envelope",
  "description": "The contract for json_view workspace items. Every agent-produced view must validate against this schema.",
  "type": "object",
  "required": ["documentMetadata", "views"],
  "properties": {
    "documentMetadata": {
      "type": "object",
      "required": ["title"],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "description": "Human-readable title for the workspace item"
        },
        "sourceId": {
          "type": "string",
          "description": "Reference to the source document or case element that produced this view"
        },
        "lastUpdated": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 timestamp of last generation"
        }
      }
    },
    "views": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "description": "One or more views composing this workspace item. Order determines render order.",
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/TableView" },
          { "$ref": "#/$defs/ListView" },
          { "$ref": "#/$defs/CardsView" },
          { "$ref": "#/$defs/ChartView" }
        ]
      }
    }
  },

  "$defs": {
    "ViewBase": {
      "type": "object",
      "required": ["viewType", "title", "data"],
      "properties": {
        "viewType": {
          "type": "string",
          "enum": ["table", "list", "cards"]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "description": "Section heading for this view within the composite"
        },
        "description": {
          "type": "string",
          "description": "Optional subtitle or context shown below the title"
        }
      }
    },

    "TableView": {
      "allOf": [
        { "$ref": "#/$defs/ViewBase" },
        {
          "properties": {
            "viewType": { "const": "table" },
            "data": {
              "type": "object",
              "required": ["headers", "rows"],
              "properties": {
                "headers": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 20,
                  "items": { "type": "string", "minLength": 1 },
                  "description": "Column headers. Order determines column order."
                },
                "rows": {
                  "type": "array",
                  "maxItems": 500,
                  "items": {
                    "type": "object",
                    "required": ["id"],
                    "properties": {
                      "id": {
                        "type": "string",
                        "minLength": 1,
                        "description": "Unique row identifier"
                      }
                    },
                    "additionalProperties": { "type": "string" }
                  },
                  "description": "Row objects. Each key maps to a column header. id is required."
                }
              }
            }
          }
        }
      ]
    },

    "ListView": {
      "allOf": [
        { "$ref": "#/$defs/ViewBase" },
        {
          "properties": {
            "viewType": { "const": "list" },
            "data": {
              "type": "object",
              "required": ["listStyle", "items"],
              "properties": {
                "listStyle": {
                  "type": "string",
                  "enum": ["checkbox", "ordered", "bullet"],
                  "description": "Visual style: checkbox = interactive toggles, ordered = numbered, bullet = plain bullets"
                },
                "items": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 200,
                  "items": {
                    "type": "object",
                    "required": ["id", "text"],
                    "properties": {
                      "id": {
                        "type": "string",
                        "minLength": 1,
                        "description": "Unique item identifier"
                      },
                      "text": {
                        "type": "string",
                        "minLength": 1,
                        "description": "The list item content"
                      },
                      "completed": {
                        "type": "boolean",
                        "default": false,
                        "description": "Only meaningful for listStyle: checkbox"
                      },
                      "notes": {
                        "type": "string",
                        "description": "Optional subtext shown below the item"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },

    "CardsView": {
      "allOf": [
        { "$ref": "#/$defs/ViewBase" },
        {
          "properties": {
            "viewType": { "const": "cards" },
            "data": {
              "type": "object",
              "required": ["pairs"],
              "properties": {
                "pairs": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 50,
                  "items": {
                    "type": "object",
                    "required": ["key", "value"],
                    "properties": {
                      "key": {
                        "type": "string",
                        "minLength": 1,
                        "description": "Label for this card"
                      },
                      "value": {
                        "type": "string",
                        "description": "Value displayed prominently"
                      },
                      "emphasis": {
                        "type": "string",
                        "enum": ["default", "warning", "danger", "success", "info"],
                        "default": "default",
                        "description": "Optional color treatment for the card border/value"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },

    "ChartView": {
      "allOf": [
        { "$ref": "#/$defs/ViewBase" },
        {
          "properties": {
            "viewType": { "const": "chart" },
            "data": {
              "type": "object",
              "required": ["chartType", "headers", "rows"],
              "properties": {
                "chartType": {
                  "type": "string",
                  "enum": ["bar", "line", "pie"]
                },
                "headers": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 20,
                  "items": { "type": "string", "minLength": 1 }
                },
                "rows": {
                  "type": "array",
                  "maxItems": 500,
                  "items": {
                    "type": "object",
                    "required": ["id"],
                    "properties": {
                      "id": { "type": "string", "minLength": 1 }
                    },
                    "additionalProperties": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
